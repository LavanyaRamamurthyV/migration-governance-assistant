# Copy this file to ".env" and fill it in. The real .env is ignored by git, never commit it.

# Which LLM answers the questions: gemini | claude | ollama | extractive (no LLM)
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com  (Get API key)
GEMINI_API_KEY=
# Optional. Leave empty and the app finds a current Flash model for your key by itself.
# GEMINI_MODEL=

# Optional alternatives
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
# OLLAMA_MODEL=llama3.2

# Secret salt used when tokenizing customer ids. Change it to any random text.
PII_SALT=change-me

# Only needed to re-run the full pipeline: folder holding the Olist CSV files
# RAW_DIR=data/raw
